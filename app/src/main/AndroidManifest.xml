<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android Automotive OS(Pleos Connect) 대상 앱.
         일반 폰/태블릿 AVD 시연도 허용하기 위해 required="false" (Pleos App Market 배포 시 true 로 전환 권장) -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <!-- AAOS 표준 차속(VHAL PERF_VEHICLE_SPEED) 구독 — 런타임 권한 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- AAOS 표준 기어(VHAL GEAR_SELECTION) — Pleos Vehicle SDK 가 자체 기어 API 대신 사용을 권고 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- Pleos Vehicle SDK: 주행 시간(Odometer) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <!-- Pleos NaviHelper: 경로 탐색·목적지·경유지(NAVI_ROUTE_SEARCH), 경로·현재 위치 조회(NAVI_ROUTE), 길안내 이벤트(NAVI_NOTIFY).
         Pleos Connect 에뮬레이터에서 확인한 protectionLevel=normal → 설치 시 자동 허용 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_NOTIFY" />
    <!-- Pleos FusedLocation: 차의 현재 위치 (GNSS + 차량 신호 융합). 검색 반경 원의 중심 · 지도가 따라가는 차 위치 -->
    <uses-permission android:name="ai.pleos.playground.service.location.fused.FUSED_LOCATION_BINDING" />
    <!-- 위치 서비스가 요구하는 런타임 권한 (protectionLevel=dangerous, Pleos 에뮬레이터 확인) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Pleos TextToSpeech / SpeechToText (normal) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- 음성 코파일럿: "경유지로 넣을까요?" 뒤에 "응 / 아니" 대답을 듣는다. 거부하면 듣지 않고 알림 버튼으로만 고른다 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 음성 코파일럿: 순정 내비가 앞에 있는 동안 해고파가 얼지 않게 하는 포그라운드 서비스 + 헤드업 제안 알림 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ 패키지 가시성
         · Pleos 시스템 서비스 존재 확인 (없으면 SDK 초기화를 건너뛰고 Mock 으로 동작)
         · 폴백용 TTS 엔진 · 음성 인식 서비스 조회 -->
    <queries>
        <package android:name="ai.pleos.playground.service.navi" />
        <package android:name="ai.pleos.playground.service.vehicle" />
        <package android:name="ai.pleos.playground.caas" />
        <package android:name="ai.pleos.playground.service.location.fused" />
        <package android:name="ai.pleos.playground.service.caas" />
        <!-- Pleos 순정 내비 앱 ([내비에서 보기] 로 화면 전환) -->
        <package android:name="ai.umos.maps.android.navigation.app" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".HaegopaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haegopa"
        tools:targetApi="35">

        <!-- android.car 구현체는 차량 OS 에만 존재 → required=false 로 일반 AVD 설치·실행 허용 -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 주행 중 시스템이 앱을 차단하지 않도록 Distraction Optimized 선언.
                 대신 주행 중 UI 제한(큰 글씨 간편 목록 · 목록 21개 상한 · 상세/영상 잠금 · 음성 안내)은 앱이 직접 책임진다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- 음성 코파일럿: 순정 내비 화면을 띄운 채 연속 운전 시간 · 식사 시간을 보고 음성으로 경유지를 제안 -->
        <service
            android:name=".copilot.CopilotService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="In-car voice co-pilot: while the built-in navigation app is in front, keeps watching driving time and meal time, then asks by voice whether to add a nearby rest stop or restaurant as a navigation waypoint." />
        </service>

        <receiver
            android:name=".copilot.CopilotActionReceiver"
            android:exported="false" />
    </application>
</manifest>
